# Centaur OS Environment Variables
# Copy this file to .env.local for local development
# DO NOT commit .env.local to version control

# =============================================================================
# APP ENVIRONMENT
# =============================================================================
# Options: development, staging, production
EXPO_PUBLIC_APP_ENV=development

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Base URL for backend API (when backend is implemented)
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# =============================================================================
# AUTHENTICATION (Supabase)
# =============================================================================
# Get these from your Supabase project settings
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# EMAIL SERVICE (Resend)
# =============================================================================
# Get your API key from https://resend.com/api-keys
# Free tier: 3,000 emails/month, $20/month for 50,000 emails
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Email sender configuration
# You must verify this domain in Resend dashboard first
RESEND_FROM_EMAIL=invites@yourdomain.com
RESEND_FROM_NAME=Your Company Name

# =============================================================================
# AUTHENTICATION (Clerk) - Alternative to Supabase
# =============================================================================
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx

# =============================================================================
# ANALYTICS (PostHog)
# =============================================================================
EXPO_PUBLIC_POSTHOG_API_KEY=phc_xxxxx

# =============================================================================
# ERROR TRACKING (Sentry)
# =============================================================================
EXPO_PUBLIC_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# =============================================================================
# PAYMENTS (RevenueCat)
# =============================================================================
EXPO_PUBLIC_REVENUECAT_API_KEY=appl_xxxxx

# =============================================================================
# SERVER-SIDE AI SECRETS (NOT EXPO_PUBLIC_)
# =============================================================================
# IMPORTANT: These keys are for server-side use ONLY.
# They should NOT have the EXPO_PUBLIC_ prefix or they will be
# exposed in the client bundle.
#
# These are accessed only in src/app/api/ routes which run server-side.

# OpenAI API Key (for Whisper transcription, task extraction)
OPENAI_API_KEY=sk-xxxxx

# Google AI API Key (for Gemini, Speech-to-Text)
GOOGLE_AI_API_KEY=AIza-xxxxx

# Anthropic API Key (for Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# =============================================================================
# LEGACY/VIBECODE AI KEYS (EXPO_PUBLIC_ - will be deprecated)
# =============================================================================
# These EXPO_PUBLIC_ keys are provided by Vibecode and may incur charges.
# Prefer using your own server-side keys above instead.
#
# EXPO_PUBLIC_VIBECODE_OPENAI_API_KEY=sk-proj-xxxxx
# EXPO_PUBLIC_VIBECODE_ANTHROPIC_API_KEY=sk-ant-xxxxx
# EXPO_PUBLIC_VIBECODE_GOOGLE_API_KEY=AIza-xxxxx

# =============================================================================
# PUSH NOTIFICATIONS (Expo)
# =============================================================================
# These are configured in app.json, not here
# See: https://docs.expo.dev/push-notifications/overview/

# =============================================================================
# TIMEZONE
# =============================================================================
TZ=Europe/London

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. All EXPO_PUBLIC_ prefixed variables are available in the client bundle
# 2. NEVER expose AI API keys with EXPO_PUBLIC_ prefix - they will leak
# 3. Use non-prefixed keys (like OPENAI_API_KEY) for server-side routes
# 4. For server-side secrets in production, use EAS Secrets
# 5. See: https://docs.expo.dev/build-reference/variables/
